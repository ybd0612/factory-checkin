# 本地运行时复制为 .env 并填写（.env 已被 .gitignore 排除，不会提交）
# 使用方式（PowerShell）：
#   逐行设置 $env:变量名="值" 后运行 python checkin.py
# 使用方式（Linux/macOS）：
#   set -a; source .env; set +a; python3 checkin.py

# 必填：站点后台「个人设置 -> 安全设置」生成的系统访问令牌
NEWAPI_TOKEN=你的访问令牌

# 必填：数字用户 ID（浏览器 F12 -> Application -> Local Storage -> user -> id）
NEWAPI_USER_ID=你的用户ID

# 可选：站点地址，默认 https://factory.pub
NEWAPI_BASE_URL=https://factory.pub
